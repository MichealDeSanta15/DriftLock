# ============================================================================
# Database Configuration
# ============================================================================

# PostgreSQL connection string
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://driftlock:driftlock_dev_password@localhost:5432/driftlock

# Database credentials (used by docker-compose)
DB_USER=driftlock
DB_PASSWORD=driftlock_dev_password
DB_NAME=driftlock

# ============================================================================
# Backend Configuration
# ============================================================================

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# SQL query logging (set to true to see all SQL executed)
SQL_ECHO=false

# ============================================================================
# API Configuration
# ============================================================================

# Backend server URL (for frontend to connect)
BACKEND_URL=http://localhost:8000

# ============================================================================
# Development vs Production
# ============================================================================

# IMPORTANT: Change these values for production
# Never commit actual credentials to repository
# Use CI/CD secrets or environment-specific configs instead
